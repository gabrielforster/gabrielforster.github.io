---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { getLangFromUrl, useTranslations, getLocaleStaticPaths } from "@i18n/utils";
import type { MarkdownHeading } from "astro";

export const getStaticPaths = getLocaleStaticPaths;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const data = lang === "pt"
  ? (await getCollection("pt-blog"))
      .filter(post => !post.data.draft)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : (await getCollection("blog"))
      .filter(post => !post.data.draft)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts: Record<string, (typeof data)[number][]> = {};
for (const post of data) {
  const year = new Date(post.data.date).getFullYear().toString();
  if (!posts[year]) posts[year] = [];
  posts[year].push(post);
}

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const headings: MarkdownHeading[] = years.map(year => ({
  depth: 2,
  slug: year,
  text: year,
}));
---

<PageLayout title={t("meta.blog.title")} description={t("meta.blog.description")} headings={headings}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        Blog
      </div>
      <div class="space-y-4">
        {!years.length && t("content.nothingHere")}
        {!!years.length && years.map(year => (
          <section class="animate space-y-4">
            <h2 id={year} class="font-semibold text-black dark:text-white">
              {year}
            </h2>
            <div>
              <ul class="flex flex-col gap-4">
                {
                  posts[year].map((post) => (
                    <li>
                      <ArrowCard entry={post}/>
                    </li>
                  ))
                }
              </ul>
            </div>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
