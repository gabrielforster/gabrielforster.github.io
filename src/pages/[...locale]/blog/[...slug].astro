---
import { getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { blogPostSlug, readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

export async function getStaticPaths() {
  const enPosts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const ptPosts = (await getCollection("pt-blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  const enPaths = enPosts.map((post) => {
    const ptPost = ptPosts.find(p => p.id === post.id);
    const translatedUrl = ptPost
      ? `/pt/blog/${blogPostSlug(ptPost.data.date, ptPost.data.slug)}`
      : undefined;
    return {
      params: { locale: undefined as undefined, slug: blogPostSlug(post.data.date, post.data.slug) },
      props: { post, translatedUrl },
    };
  });

  const ptPaths = ptPosts.map((post) => {
    const enPost = enPosts.find(p => p.id === post.id);
    const translatedUrl = enPost
      ? `/blog/${blogPostSlug(enPost.data.date, enPost.data.slug)}`
      : undefined;
    return {
      params: { locale: "pt", slug: blogPostSlug(post.data.date, post.data.slug) },
      props: { post, translatedUrl },
    };
  });

  return [...enPaths, ...ptPaths];
}

const { post, translatedUrl } = Astro.props;
const { Content, headings } = await render(post);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<PageLayout title={post.data.title} description={post.data.description} headings={headings} translatedUrl={translatedUrl}>
  <Container>
    <div class="animate">
      <BackToPrev href={translatePath("blog")}>
        {t("blog.backToBlog")}
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body ?? "")}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
