---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { dateRange } from "@lib/utils";
import { SITE, HOME, SOCIALS } from "@consts";
import type { MarkdownHeading } from "astro";

const headings: MarkdownHeading[] = [
  { depth: 2, slug: "about", text: "About" },
  { depth: 2, slug: "work-experience", text: "Work Experience" },
  // { depth: 2, slug: "recent-projects", text: "Recent projects" },
  { depth: 2, slug: "latest-posts", text: "Latest posts" },
  { depth: 2, slug: "lets-connect", text: "Let's connect" },
];

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

// const projects = (await getCollection("projects"))
//   .filter(project => !project.data.draft)
//   .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
//   .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const work = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf())
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} headings={headings}>
  <Container>
    <h4 class="animate font-semibold text-black dark:text-white flex gap-1 items-center">
      <span>
        Hi, I'm Gabriel
      </span>
      <span class="text-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-smile-icon lucide-smile"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
      </span>
    </h4>
    <div class="space-y-16">
      <section>
        <h2 id="about" class="sr-only">About</h2>
        <article class="space-y-4">
          <p class="animate">
            I am a fullstack software developer with expertise in building robust, simple and maintanable systems.
            Committed to delivering innovative solutions for complex problems. Currently, undergrad software engineering student.
          </p>

          <p class="animate">
            Located in South Brazil, I have been working with software development for over 3 years.
          </p>

          <p class="animate">
            Proficient in NodeJS, ReactJS, VueJS, SQL and No-SQL databases, Serverless and Microservices architecture.
            Familiarity with On-premises architecture, Docker, CI/CD pipelines, Linux and server configuration, Real-time applications e Pub-Sub.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 id="work-experience" class="font-semibold text-black dark:text-white">
            Work Experience
          </h2>
          <Link href="/work">
            Show more
          </Link>
        </div>
        <ul class="flex flex-col sm:flex-row gap-4">
          {work.map(entry => (
            <li class="flex-1">
              <div class="rounded-lg border border-black/15 dark:border-white/20 p-4 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200 ease-in-out h-full cursor-pointer">
                <div class="font-semibold text-black dark:text-white text-sm">
                  {entry.data.company}
                </div>
                <div class="text-xs mt-1">
                  {entry.data.role}
                </div>
                <div class="text-xs opacity-75 mt-1">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 id="recent-projects" class="font-semibold text-black dark:text-white">
            Recent projects
          </h2>
          <Link href="/projects">
            Show more
          </Link>
        </div>
        <ul class="flex flex-col sm:flex-row gap-4">
          {projects.map(project => (
            <li class="flex-1">
              <div class="rounded-lg border border-black/15 dark:border-white/20 p-4 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-200 ease-in-out h-full cursor-pointer">
                <div class="font-semibold text-black dark:text-white text-sm">
                  {project.data.title}
                </div>
                <div class="text-xs mt-1">
                  {project.data.description}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section> -->

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 id="latest-posts" class="font-semibold text-black dark:text-white">
            Latest posts
          </h2>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 id="lets-connect" class="font-semibold text-black dark:text-white">
          Let's connect
        </h2>
        <article>
          <p>
            If you want to get in touch with me,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
            {"/"}
          </li>
          {SOCIALS.map((SOCIAL, index) => (
          <li class="flex gap-x-2 text-nowrap">
              {index !== 0 && "/"}
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
